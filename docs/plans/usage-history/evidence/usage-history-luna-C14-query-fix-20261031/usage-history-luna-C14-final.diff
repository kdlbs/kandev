+func reportUTCMonthCurrencyEdgeSource(predicate usageReportQuery, postgres bool) usageReportQuery {
+	selectSQL := `SELECT c.model,c.provider,substr(local.period,1,7)||'-01' AS period,c.metric_kind,c.currency,c.usage_date,c.rate_tokens`
+	if !postgres {
+		return usageReportQuery{
+			sql: selectSQL + ` FROM usage_projection_contributions c
+	 JOIN usage_projection_applied a ON a.scope_id=c.scope_id AND a.generation=c.generation AND a.work_key=c.work_key AND a.build_id=c.build_id
+	 JOIN usage_report_utc_calendar u ON u.utc_date=c.usage_date AND u.full_month=0
+	 JOIN usage_report_calendar local ON c.coverage_start>=local.start_at AND c.coverage_start<local.end_at
+	 WHERE c.calendar='UTC' AND c.coverage_kind='point' AND c.coverage_start>=u.start_at AND c.coverage_start<u.end_at AND ` + predicate.sql,
+			args: predicate.args,
+		}
+	}
+	// Correlate each edge day with its timestamp range so PostgreSQL can seek
+	// the point index instead of walking every applied work item in the scope.
+	return usageReportQuery{
+		sql: selectSQL + ` FROM usage_report_utc_calendar u
+	 CROSS JOIN LATERAL (SELECT c.* FROM usage_projection_contributions c WHERE ` + predicate.sql + `
+	 AND c.calendar='UTC' AND c.coverage_kind='point' AND c.usage_date=u.utc_date
+	 AND c.coverage_start>=u.start_at AND c.coverage_start<u.end_at OFFSET 0) c
+	 JOIN usage_projection_applied a ON a.scope_id=c.scope_id AND a.generation=c.generation AND a.work_key=c.work_key AND a.build_id=c.build_id
+	 JOIN usage_report_calendar local ON c.coverage_start>=local.start_at AND c.coverage_start<local.end_at
+	 WHERE u.full_month=0`,
+		args: predicate.args,
+	}
+}
