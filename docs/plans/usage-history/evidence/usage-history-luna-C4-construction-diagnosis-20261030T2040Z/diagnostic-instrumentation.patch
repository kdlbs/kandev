+func (o *usageBenchObserver) recordAggregateLocked(statement usageBenchStatement, err error) {
+	normalized := normalizeUsageBenchSQLTemplate(statement.SQL)
+	if normalized == "" {
+		normalized = "<empty>"
+	}
+	fingerprint := sha256.Sum256([]byte(normalized))
+	phase := o.currentPhase
+	if phase == "" {
+		phase = "unspecified"
+	}
+	family := usageBenchSQLFamily(normalized)
+	key := phase + "\x00" + family + "\x00" + hex.EncodeToString(fingerprint[:])
+	aggregate, exists := o.aggregates[key]
+	if !exists {
+		if len(o.aggregates) >= o.aggregateLimit {
+			o.droppedStatements++
+			if err != nil {
+				o.err = err
+			}
+			return
+		}
+		template := normalized
+		if len(template) > 512 {
+			template = template[:512]
+		}
+		aggregate = usageBenchSQLAggregate{
+			Phase: phase, SQLFamily: family, Fingerprint: hex.EncodeToString(fingerprint[:]), SQLTemplate: template,
+		}
+	}
+	aggregate.Count++
+	aggregate.TotalNS += statement.DurationNS
+	if statement.DurationNS > aggregate.MaxNS {
+		aggregate.MaxNS = statement.DurationNS
+	}
+	for _, loop := range statement.SQLiteLoops {
+		aggregate.Loops += loop.Loops
+		aggregate.Visits += loop.Visits
+	}
+	if err != nil || statement.Error != "" {
+		aggregate.Errors++
+	}
+	o.aggregates[key] = aggregate
+	if err != nil {
+		o.err = err
+	}
