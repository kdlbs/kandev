+//go:build cgo && sqlite_trace && usage_history_scanstatus
+
+package sqlite
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	sqlite3 "github.com/mattn/go-sqlite3"
+)
+
+type usageBenchConstructionMetrics struct {
+	SetupNS            int64 `json:"fixture_setup_ns"`
+	RecentPhaseNS      int64 `json:"recent_phase_ns"`
+	OracleCalls        int64 `json:"scalar_oracle_calls"`
+	OracleNS           int64 `json:"scalar_oracle_ns"`
+	SeedRecordCalls    int64 `json:"fixture_record_build_calls"`
+	SeedRecordNS       int64 `json:"fixture_record_build_ns"`
+	SnapshotBatches    int64 `json:"snapshot_insert_batches"`
+	SnapshotRows       int64 `json:"snapshot_insert_rows"`
+	SnapshotNS         int64 `json:"snapshot_insert_ns"`
+	AdmissionBatches   int64 `json:"real_admission_batches"`
+	AdmissionRows      int64 `json:"real_admission_rows"`
+	AdmissionNS        int64 `json:"real_admission_ns"`
+	SpecialAdmissionNS int64 `json:"special_record_admission_ns"`
+	RetentionCalls     int64 `json:"retention_calls"`
+	RetentionNS        int64 `json:"retention_ns"`
+	ProjectionCalls    int64 `json:"projection_calls"`
+	ProjectionNS       int64 `json:"projection_worker_ns"`
+	ProjectionMaxNS    int64 `json:"projection_worker_max_call_ns"`
+	AnalyzeNS          int64 `json:"post_publication_analyze_ns"`
+	PostMutationNS     int64 `json:"post_publication_mutations_ns"`
+}
+
+type usageBenchSQLPhaseTotal struct {
+	Phase     string `json:"phase"`
+	SQLFamily string `json:"sql_family"`
+	Count     int64  `json:"count"`
+	TotalNS   int64  `json:"total_duration_ns"`
+	MaxNS     int64  `json:"max_duration_ns"`
+	Loops     int64  `json:"scan_loops"`
+	Visits    int64  `json:"scan_visits"`
+}
+
+type usageBenchConstructionProfile struct {
+	SchemaVersion         int                           `json:"schema_version"`
+	RecordedAtUTC         time.Time                     `json:"recorded_at_utc"`
+	Test                  string                        `json:"test"`
+	Engine                string                        `json:"engine"`
+	SourceSeedMode        string                        `json:"source_seed_mode"`
+	ConfiguredFixture     usageBenchSize                `json:"configured_fixture"`
+	ActualRetained        usageBenchStorage             `json:"actual_retained_and_published"`
+	OracleExpectedFacts   int64                         `json:"scalar_oracle_expected_facts"`
+	OracleExpectedMetrics int64                         `json:"scalar_oracle_expected_contributions"`
+	ProjectionCalls       int                           `json:"projection_calls"`
+	RetentionPages        int                           `json:"retention_pages"`
+	PhaseNS               usageBenchConstructionMetrics `json:"phase_durations_and_counts"`
+	SQLAggregateLimit     int                           `json:"sql_aggregate_limit"`
+	SQLDroppedStatements  int64                         `json:"sql_aggregate_dropped_statements"`
+	SQLAggregatesComplete bool                          `json:"sql_aggregates_complete"`
+	SQLPhaseTotals        []usageBenchSQLPhaseTotal     `json:"sql_phase_totals"`
+	SQLAggregates         []usageBenchSQLAggregate      `json:"sql_statement_aggregates"`
+	SQLiteVersion         string                        `json:"sqlite_version"`
+	GoVersion             string                        `json:"go_version"`
+	GOOS                  string                        `json:"goos"`
+	GOARCH                string                        `json:"goarch"`
+	NumCPU                int                           `json:"num_cpu"`
+	GOMAXPROCS            int                           `json:"gomaxprocs"`
+	GOMEMLIMIT            string                        `json:"gomemlimit"`
+	CgroupCPUMax          string                        `json:"cgroup_cpu_max"`
+	CgroupMemoryMax       string                        `json:"cgroup_memory_max"`
+	LoadAverage           string                        `json:"load_average"`
+	CPUAffinity           string                        `json:"cpu_affinity"`
+	SQLArgumentsCaptured  bool                          `json:"sql_arguments_captured"`
+	SQLCoverage           string                        `json:"sql_coverage"`
+	CountsValidated       bool                          `json:"production_counts_and_oracle_validated"`
+}
+
+func usageBenchConstructionProfileRequested() bool {
+	return os.Getenv("KANDEV_USAGE_CONSTRUCTION_PROFILE") == "1"
+}
+
+func (f *usageBenchFixture) setConstructionProfilePhase(phase string) {
+	if f.profileMetrics != nil {
+		f.observer.setPhase(phase)
+	}
+}
+
+func (m *usageBenchConstructionMetrics) addProjectionDuration(elapsedNS int64) {
+	m.ProjectionCalls++
+	m.ProjectionNS += elapsedNS
+	if elapsedNS > m.ProjectionMaxNS {
+		m.ProjectionMaxNS = elapsedNS
+	}
+}
+
+func writeUsageBenchConstructionProfile(t testing.TB, fixture *usageBenchFixture) {
+	t.Helper()
+	metrics := fixture.profileMetrics
+	if metrics == nil {
+		t.Fatal("construction profile metrics were not enabled")
+	}
+	if metrics.OracleCalls == 0 || metrics.SnapshotRows == 0 || fixture.retentionPages == 0 || metrics.ProjectionCalls != int64(fixture.projectionSteps) {
+		t.Fatalf("construction profile counters are incomplete: %+v; retention_pages=%d projection_steps=%d", metrics, fixture.retentionPages, fixture.projectionSteps)
+	}
+	profile := readUsageBenchConstructionProfile(t, fixture, metrics)
+	writeUsageBenchConstructionProfileFile(t, fixture, profile)
+}
+
+func readUsageBenchConstructionProfile(t testing.TB, fixture *usageBenchFixture, metrics *usageBenchConstructionMetrics) usageBenchConstructionProfile {
+	t.Helper()
+	encoded, err := fixture.observer.aggregateSnapshotJSON()
+	usageBenchMust(t, err)
+	var aggregate usageBenchAggregateSnapshot
+	usageBenchMust(t, json.Unmarshal(encoded, &aggregate))
+	version, _, _ := sqlite3.Version()
+	seedMode := "snapshot_import_plus_production_projection"
+	if fixture.ordinaryAdmission {
+		seedMode = "ordinary_admission_plus_production_projection"
+	}
+	return usageBenchConstructionProfile{
+		SchemaVersion: 1, RecordedAtUTC: time.Now().UTC(), Test: t.Name(), Engine: fixture.engine, SourceSeedMode: seedMode,
+		ConfiguredFixture: fixture.size, ActualRetained: fixture.storage,
+		OracleExpectedFacts:   fixture.expectedFacts[fixture.subjects[0].scope],
+		OracleExpectedMetrics: fixture.expectedContributions[fixture.subjects[0].scope],
+		ProjectionCalls:       fixture.projectionSteps, RetentionPages: fixture.retentionPages, PhaseNS: *metrics,
+		SQLAggregateLimit: maxUsageBenchSQLAggregates, SQLDroppedStatements: aggregate.DroppedStatements, SQLAggregatesComplete: aggregate.DroppedStatements == 0,
+		SQLPhaseTotals: summarizeUsageBenchSQLPhases(aggregate.Aggregates), SQLAggregates: aggregate.Aggregates,
+		SQLiteVersion: version, GoVersion: runtime.Version(), GOOS: runtime.GOOS, GOARCH: runtime.GOARCH,
+		NumCPU: runtime.NumCPU(), GOMAXPROCS: runtime.GOMAXPROCS(0), GOMEMLIMIT: os.Getenv("GOMEMLIMIT"),
+		CgroupCPUMax:    readUsageBenchProfileFile("/sys/fs/cgroup/cpu.max"),
+		CgroupMemoryMax: readUsageBenchProfileFile("/sys/fs/cgroup/memory.max"),
+		LoadAverage:     readUsageBenchProfileFile("/proc/loadavg"), CPUAffinity: readUsageBenchCPUAffinity(),
+		SQLArgumentsCaptured: false,
+		SQLCoverage:          "bounded from recent source-range generation through retention and production projection; fixture database and repository setup are timed separately without SQL tracing",
+		CountsValidated:      true,
+	}
+}
+
+func readUsageBenchProfileFile(path string) string {
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(content))
+}
+
+func readUsageBenchCPUAffinity() string {
+	for _, line := range strings.Split(readUsageBenchProfileFile("/proc/self/status"), "\n") {
+		key, value, ok := strings.Cut(line, ":")
+		if ok && key == "Cpus_allowed_list" {
+			return strings.TrimSpace(value)
+		}
+	}
+	return ""
+}
+
+func summarizeUsageBenchSQLPhases(aggregates []usageBenchSQLAggregate) []usageBenchSQLPhaseTotal {
+	totals := map[string]usageBenchSQLPhaseTotal{}
+	for _, aggregate := range aggregates {
+		key := aggregate.Phase + "\x00" + aggregate.SQLFamily
+		item := totals[key]
+		item.Phase, item.SQLFamily = aggregate.Phase, aggregate.SQLFamily
+		item.Count += aggregate.Count
+		item.TotalNS += aggregate.TotalNS
+		item.Loops += aggregate.Loops
+		item.Visits += aggregate.Visits
+		if aggregate.MaxNS > item.MaxNS {
+			item.MaxNS = aggregate.MaxNS
+		}
+		totals[key] = item
+	}
+	result := make([]usageBenchSQLPhaseTotal, 0, len(totals))
+	for _, total := range totals {
+		result = append(result, total)
+	}
+	sort.Slice(result, func(i, j int) bool {
+		if result[i].TotalNS != result[j].TotalNS {
+			return result[i].TotalNS > result[j].TotalNS
+		}
+		return result[i].Phase+result[i].SQLFamily < result[j].Phase+result[j].SQLFamily
+	})
+	return result
+}
+
+func writeUsageBenchConstructionProfileFile(t testing.TB, fixture *usageBenchFixture, profile usageBenchConstructionProfile) {
+	t.Helper()
+	directory := os.Getenv("KANDEV_USAGE_CONSTRUCTION_PROFILE_DIR")
+	if directory == "" {
+		t.Fatal("construction profile requires KANDEV_USAGE_CONSTRUCTION_PROFILE_DIR")
+	}
+	if err := os.MkdirAll(directory, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	name := fmt.Sprintf("usage-history-luna-C4-construction-config-%d-%d.json", fixture.size.Native, fixture.size.External)
+	path := filepath.Join(directory, name)
+	encoded, err := json.MarshalIndent(profile, "", "  ")
+	usageBenchMust(t, err)
+	usageBenchMust(t, os.WriteFile(path, append(encoded, '\n'), 0o644))
+	t.Logf("bounded construction profile=%s actual_native=%d actual_external=%d projection_calls=%d sql_aggregates=%d dropped_statements=%d", path, fixture.storage.RetainedNative, fixture.storage.RetainedExternal, fixture.projectionSteps, len(profile.SQLAggregates), profile.SQLDroppedStatements)
+}
