+//go:build cgo && sqlite_trace && usage_history_scanstatus
+
+package sqlite
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+type usageBenchAggregateTestObserver interface {
+	startAggregating(int)
+	setPhase(string)
+	record(usageBenchStatement, error)
+	aggregateSnapshotJSON() ([]byte, error)
+}
+
+type usageBenchAggregateTestEntry struct {
+	Phase       string `json:"phase"`
+	SQLFamily   string `json:"sql_family"`
+	Fingerprint string `json:"fingerprint"`
+	SQLTemplate string `json:"sql_template"`
+	Count       int64  `json:"count"`
+	TotalNS     int64  `json:"total_duration_ns"`
+	MaxNS       int64  `json:"max_duration_ns"`
+	Loops       int64  `json:"scan_loops"`
+	Visits      int64  `json:"scan_visits"`
+}
+
+type usageBenchAggregateTestSnapshot struct {
+	Aggregates        []usageBenchAggregateTestEntry `json:"aggregates"`
+	DroppedStatements int64                          `json:"dropped_statements"`
+}
+
+func TestUsageBenchObserverAggregatesBoundedSQLStats(t *testing.T) {
+	observer, ok := any(&usageBenchObserver{}).(usageBenchAggregateTestObserver)
+	if !ok {
+		t.Fatal("usage benchmark observer must support bounded SQL aggregation")
+	}
+	observer.startAggregating(2)
+	observer.setPhase("projection_worker")
+	observer.record(usageBenchStatement{
+		SQL:         "SELECT selection_coverage FROM session_usage_measurements WHERE scope_id = ? AND source = 'native' AND revision = 17",
+		DurationNS:  100,
+		SQLiteLoops: []usageBenchScanLoop{{Loops: 2, Visits: 10}},
+	}, nil)
+	observer.record(usageBenchStatement{
+		SQL:         "SELECT  selection_coverage\nFROM session_usage_measurements WHERE scope_id = ? AND source = 'native' AND revision = 17",
+		DurationNS:  200,
+		SQLiteLoops: []usageBenchScanLoop{{Loops: 1, Visits: 5}},
+	}, nil)
+	observer.record(usageBenchStatement{
+		SQL:        "SELECT selection_coverage FROM session_usage_measurements WHERE scope_id = ? AND source = 'plugin:bench' AND revision = 23",
+		DurationNS: 300,
+	}, nil)
+	observer.record(usageBenchStatement{
+		SQL:        "SELECT selection_coverage FROM session_usage_measurements WHERE scope_id = ? AND source = 'native:alternate' AND revision = 51",
+		DurationNS: 400,
+	}, nil)
+	observer.record(usageBenchStatement{
+		SQL:        "SELECT provider FROM usage_projection_provider_options WHERE scope_id = ?",
+		DurationNS: 50,
+	}, nil)
+	observer.record(usageBenchStatement{SQL: "SELECT value FROM uncaptured_table", DurationNS: 75}, nil)
+
+	encoded, err := observer.aggregateSnapshotJSON()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var snapshot usageBenchAggregateTestSnapshot
+	if err := json.Unmarshal(encoded, &snapshot); err != nil {
+		t.Fatal(err)
+	}
+	if len(snapshot.Aggregates) != 2 {
+		t.Fatalf("aggregate count = %d, want 2", len(snapshot.Aggregates))
+	}
+	if snapshot.DroppedStatements != 1 {
+		t.Fatalf("dropped statements = %d, want 1", snapshot.DroppedStatements)
+	}
+	var selection *usageBenchAggregateTestEntry
+	for i := range snapshot.Aggregates {
+		if snapshot.Aggregates[i].SQLFamily == "selection" {
+			selection = &snapshot.Aggregates[i]
+		}
+	}
+	if selection == nil {
+		t.Fatal("selection SQL family was not retained")
+	}
+	if selection.Phase != "projection_worker" || selection.Count != 4 || selection.TotalNS != 1000 || selection.MaxNS != 400 || selection.Loops != 3 || selection.Visits != 15 {
+		t.Fatalf("selection aggregate = %+v, want phase projection_worker, 4 literal/whitespace-normalized calls, 1000ns total, 400ns max, 3 loops and 15 visits", *selection)
+	}
+	if selection.Fingerprint == "" || selection.SQLTemplate == "" {
+		t.Fatalf("selection aggregate lacks bounded query identity: %+v", *selection)
+	}
+}
