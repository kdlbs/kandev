+	case strings.Contains(lower, "selection_partition"), strings.Contains(lower, "selection_coverage"), strings.Contains(lower, "coverage_start"), strings.Contains(lower, "coverage_end"), strings.Contains(lower, "selection_layout"), strings.Contains(lower, "selection_segment"):
