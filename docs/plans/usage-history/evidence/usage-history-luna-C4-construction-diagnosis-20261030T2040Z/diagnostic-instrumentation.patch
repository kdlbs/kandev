+				index++
+			}
+			space = true
+			continue
+		}
+		if current == '/' && index+1 < len(query) && query[index+1] == '*' {
+			index += 2
+			for index+1 < len(query) && !(query[index] == '*' && query[index+1] == '/') {
+				index++
+			}
+			if index+1 < len(query) {
+				index += 2
+			}
+			space = true
+			continue
+		}
+		if space && normalized.Len() > 0 {
+			normalized.WriteByte(' ')
+		}
+		space = false
+		switch {
+		case current == '\'':
+			normalized.WriteByte('?')
+			index = skipUsageBenchSQLQuoted(query, index+1, '\'')
+		case current == '"' || current == '`' || current == '[':
+			closing := current
+			if current == '[' {
