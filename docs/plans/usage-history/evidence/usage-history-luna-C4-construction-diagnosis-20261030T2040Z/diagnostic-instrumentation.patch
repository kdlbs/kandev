+	case strings.Contains(lower, "usage_projection_provider_options"):
+		return "provider"
+	case strings.Contains(lower, "usage_daily_summaries"), strings.Contains(lower, "usage_lifetime_summaries"), strings.Contains(lower, "usage_projection_summary_queue"):
+		return "summary"
+	case strings.Contains(lower, "usage_projection_log"):
