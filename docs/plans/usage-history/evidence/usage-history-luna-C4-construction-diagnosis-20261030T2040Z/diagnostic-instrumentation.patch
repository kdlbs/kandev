+			normalized.WriteByte('?')
+			index = skipUsageBenchSQLNumber(query, index)
+		case current == '?' || current == ':' || current == '@' || current == '$':
+			normalized.WriteByte('?')
+			index++
+			for index < len(query) && isUsageBenchSQLParameterByte(query[index]) {
+				index++
+			}
+		default:
+			normalized.WriteByte(current)
+			index++
+		}
+	}
+	return strings.TrimSpace(normalized.String())
+}
+
+func skipUsageBenchSQLQuoted(query string, index int, quote byte) int {
+	for index < len(query) {
+		if query[index] == quote {
+			if index+1 < len(query) && query[index+1] == quote {
+				index += 2
+				continue
+			}
+			return index + 1
+		}
+		index++
+	}
+	return index
+}
+
+func copyUsageBenchSQLQuoted(output *strings.Builder, query string, index int, opening, closing byte) int {
+	output.WriteByte(opening)
+	index++
+	for index < len(query) {
+		current := query[index]
+		output.WriteByte(current)
+		index++
+		if current == closing {
+			if index < len(query) && query[index] == closing {
+				output.WriteByte(query[index])
+				index++
+				continue
+			}
+			return index
+		}
+	}
+	return index
+}
+
+func skipUsageBenchSQLNumber(query string, index int) int {
+	if index+2 < len(query) && query[index] == '0' && (query[index+1] == 'x' || query[index+1] == 'X') {
+		index += 2
+		for index < len(query) && (isUsageBenchSQLDigit(query[index]) || query[index] >= 'a' && query[index] <= 'f' || query[index] >= 'A' && query[index] <= 'F') {
+			index++
+		}
+		return index
+	}
+	for index < len(query) && isUsageBenchSQLDigit(query[index]) {
+		index++
+	}
+	if index < len(query) && query[index] == '.' && (index+1 == len(query) || query[index+1] != '.') {
+		index++
+		for index < len(query) && isUsageBenchSQLDigit(query[index]) {
+			index++
+		}
+	}
+	if index < len(query) && (query[index] == 'e' || query[index] == 'E') {
+		exponent := index + 1
+		if exponent < len(query) && (query[exponent] == '+' || query[exponent] == '-') {
+			exponent++
+		}
+		digits := exponent
+		for exponent < len(query) && isUsageBenchSQLDigit(query[exponent]) {
+			exponent++
+		}
+		if exponent > digits {
+			index = exponent
+		}
+	}
+	return index
+}
+
+func isUsageBenchSQLSpace(value byte) bool {
+	return value == ' ' || value == '\t' || value == '\n' || value == '\r' || value == '\f'
+}
+
+func isUsageBenchSQLDigit(value byte) bool {
+	return value >= '0' && value <= '9'
+}
+
+func isUsageBenchSQLWordByte(value byte) bool {
+	return value == '_' || value >= 'a' && value <= 'z' || value >= 'A' && value <= 'Z' || isUsageBenchSQLDigit(value)
+}
+
+func isUsageBenchSQLParameterByte(value byte) bool {
+	return isUsageBenchSQLWordByte(value) || value == '_'
+}
+
 func (o *usageBenchObserver) finish() ([]usageBenchStatement, error) {
 	o.mu.Lock()
 	defer o.mu.Unlock()
