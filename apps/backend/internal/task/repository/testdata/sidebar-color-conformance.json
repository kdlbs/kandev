      "automation": { "enabled": true, "rules": [{ "id": "step", "enabled": true, "condition": { "dimension": "workflow_step", "value": { "workspace_id": "sidebar-color-workflow-step", "step_id": "target-step" }, "label": "Step" }, "output": { "kind": "fixed", "color": "red" } }] },
      "preferred_color": "red",
      "expected_token": "red",
