{
  "type": "object",
  "description": "One literal tree: at most four Chart, Table, StatusList, Metrics or FilePreview data components. Callout and Text are explanatory. At most eight levels; every element must be reachable exactly once.",
  "examples": [
    {
      "version": 2,
      "catalog_version": 1,
      "title": "Service failures",
      "spec": {
        "root": "failures",
        "elements": {
          "failures": {
            "type": "Chart",
            "props": {
              "chart_type": "bar",
              "title": "Failures by service",
              "summary": "Failed requests in the latest interval.",
              "labels": [
                "A",
                "B"
              ],
              "series": [
                {
                  "label": "Count",
                  "values": [
                    42,
                    27
                  ]
                }
              ]
            },
            "children": []
          }
        }
      }
    },
    {
      "version": 2,
      "catalog_version": 1,
      "title": "Latency trend",
      "spec": {
        "root": "latency",
        "elements": {
          "latency": {
            "type": "Chart",
            "props": {
              "chart_type": "line",
              "title": "p95 latency",
              "summary": "Latency across recorded samples.",
              "csv": {
                "path": "reports/latency.csv",
                "x_column": "recorded_at",
                "series": [
                  {
                    "column": "p95_ms",
                    "label": "p95 (ms)"
                  }
                ]
              }
            },
            "children": []
          }
        }
      }
    },
    {
      "version": 2,
      "catalog_version": 1,
      "title": "Build health",
      "spec": {
        "root": "report",
        "elements": {
          "report": {
            "type": "Stack",
            "props": {
              "direction": "horizontal"
            },
            "children": [
              "checks",
              "context"
            ]
          },
          "checks": {
            "type": "Group",
            "props": {
              "title": "Checks"
            },
            "children": [
              "counts"
            ]
          },
          "counts": {
            "type": "Metrics",
            "props": {
              "items": [
                {
                  "label": "Passed",
                  "value": "38"
                }
              ]
            },
            "children": []
          },
          "context": {
            "type": "Text",
            "props": {
              "text": "All focused checks passed."
            },
            "children": []
          }
        }
      }
    },
    {
      "version": 2,
      "catalog_version": 1,
      "title": "Service comparison",
      "spec": {
        "root": "services",
        "elements": {
          "services": {
            "type": "Table",
            "props": {
              "columns": [
                {
                  "key": "service",
                  "label": "Service"
                },
                {
                  "key": "cost",
                  "label": "Monthly cost (USD)"
                }
              ],
              "rows": [
                [
                  "API",
                  "420"
                ],
                [
                  "Payments",
                  "680"
                ]
              ]
            },
            "children": []
          }
        }
      }
    },
    {
      "version": 2,
      "catalog_version": 1,
