    {
      "version": 2,
      "catalog_version": 1,
      "title": "Verification findings",
      "spec": {
        "root": "checks",
        "elements": {
          "checks": {
            "type": "StatusList",
            "props": {
              "title": "Verification",
              "items": [
                {
                  "label": "Unit tests",
