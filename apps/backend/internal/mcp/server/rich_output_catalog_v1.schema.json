        "root": "finding",
        "elements": {
          "finding": {
            "type": "Callout",
            "props": {
              "kind": "warning",
              "title": "Investigate Payments",
              "text": "Payments has the highest monthly cost and p95 latency in this sample."
            },
            "children": []
          }
        }
      }
