{
  "name": "kandev-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:web": "pnpm --filter @kandev/web dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @kandev/web build",
    "lint": "pnpm -r run lint",
    "dead-code": "knip --include files,exports,dependencies --no-progress",
    "format": "prettier --write web cli packages --ignore-unknown",
    "format:check": "prettier --check web cli packages --ignore-unknown",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "^20",
    "knip": "6.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.5.3",
      "@codemirror/view": "6.39.10",
      "@babel/core": "^7.29.6",
      "@hono/node-server": "^2.0.5",
      "@isaacs/brace-expansion": "^5.0.1",
      "@modelcontextprotocol/sdk": "^1.26.0",
      "adm-zip": "^0.6.0",
      "ajv@6": "6.15.0",
      "body-parser": "^2.3.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "dompurify": "^3.4.13",
      "fast-uri": "^3.1.5",
      "flatted": "^3.4.2",
      "hono": "^4.12.34",
      "ip-address": "^10.3.1",
      "js-yaml@4": "^4.3.1",
      "linkify-it": "^5.0.2",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "markdown-it": "^14.2.0",
      "mermaid": "^11.16.1",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "postcss": "^8.5.23",
      "protobufjs": "^7.6.5",
      "qs": "^6.15.2",
      "sharp": "^0.35.0",
      "uuid@11": "^11.1.1",
      "ws": "^8.21.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
