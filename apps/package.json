{
  "name": "kandev-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "pnpm -r run dev",
    "dev:web": "pnpm --filter @kandev/web dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @kandev/web build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write web cli packages --ignore-unknown",
    "format:check": "prettier --check web cli packages --ignore-unknown",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "^20",
    "prettier": "^3.6.2",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.5.3",
      "@codemirror/view": "6.39.10",
      "postcss": "^8.5.12",
      "fast-uri": "^3.1.4",
      "sharp": "^0.35.0",
      "linkify-it": "^5.0.2",
      "js-yaml@4": "^4.3.0",
      "adm-zip": "^0.6.0",
      "hono": "^4.12.25",
      "@hono/node-server": "^1.19.10",
      "ws": "^8.21.0",
      "lodash": "^4.18.0",
      "lodash-es": "^4.18.0",
      "flatted": "^3.4.2",
      "@isaacs/brace-expansion": "^5.0.1",
      "@modelcontextprotocol/sdk": "^1.26.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  }
}
