# Hoist @lezer/highlight for codemirror theme packages that expect it as a peer dependency
public-hoist-pattern[]=@lezer/*

confirm-modules-purge=false

# This workspace is installed for development, testing, and builds. The runtime
# image ships prebuilt Go and SPA artifacts and does not install `apps/` itself.
# Without this, `pnpm install` reports "devDependencies: skipped because NODE_ENV
# is set to production" inside the runtime container image (`Dockerfile` sets
# `NODE_ENV=production`), leaving no vitest, eslint, or tsc. See the same variable's
# effect on React's build variant in `web/vitest.config.ts`.
production=false
