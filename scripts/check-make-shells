#!/usr/bin/env bash
# check-make-shells — assert that apps/backend/Makefile's run/dev/start-debug
# and deadcode targets expand to the correct per-shell command line, without
# building them.
#
# The Makefile dispatches on two independent axes:
#   * EXE suffix   — keyed on $(OS): any Windows build (native cmd/PowerShell
#                    OR Git Bash) produces kandev.exe.
#   * shell syntax — keyed on $(OS)$(MSYSTEM): only native cmd/PowerShell uses
#                    `set VAR=VAL&` + backslash path + no exec; Unix and Git
#                    Bash/MSYS use POSIX `VAR=val exec`.
# Git Bash is the trap — it sets OS=Windows_NT yet runs recipes through sh, so
# it must take the POSIX branch while keeping the .exe suffix. Conflating the
# two axes (the pre-fix bug) made Git Bash emit `set VAR=VAL&` into bash, where
# the env var is never exported.
#
# Each shell is simulated deterministically with make's OS=/MSYSTEM=
# command-line overrides, so one host checks the dispatch for all three shells
# without having to run on each. The harness itself is bash (grep, sed), so it
# needs a POSIX shell — it runs in the Linux CI job and under Git Bash/WSL
# locally, not from native cmd.exe/PowerShell. Covers the Make-target dispatch
# that the backend Go CI jobs don't exercise. When cmd.exe is available, the
# script also runs an isolated mkdir probe without building any binaries.
#
# The same harness executes the root Makefile's POSIX web builds with a pnpm
# recorder and dry-runs the native Windows frontend recipe, so an inherited
# NODE_ENV cannot silently select React's development runtime.

set -euo pipefail

backend_dir="$(cd "$(dirname "$0")/../apps/backend" && pwd)"

status=0
windows_mkdir_recipe=

# expect <label> <OS> <MSYSTEM> <target> <expected recipe tail>
expect() {
	local label=$1 os=$2 msys=$3 target=$4 want=$5 marker=${6:-__backend} title_prefix=${7:-} got
	# The OS=/MSYSTEM= overrides only steer which branch the Makefile picks;
	# $(shell ...) still runs under this harness's POSIX shell, and it expands
	# even under `make -n`. So neutralise the build-stamp probes rather than let
	# the windows-native case run them: NULL_REDIR=NUL would have sh create a
	# junk ./NUL, and BUILD_TIME would spawn PowerShell per case. Blanking
	# NULL_REDIR (rather than passing /dev/null) also dodges Git Bash rewriting
	# a /dev/null argument to `nul` on its way to native make. None of this
	# affects the run/dev/start-debug recipes under assertion.
	if [ -n "$title_prefix" ]; then
		got=$(KANDEV_WEB_TITLE_PREFIX="$title_prefix" make -C "$backend_dir" OS="$os" MSYSTEM="$msys" NULL_REDIR= BUILD_TIME=simulated -n "$target" 2>/dev/null \
			| grep -F "$marker" \
			| sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g' \
			|| true)
	else
		got=$(env -u KANDEV_WEB_TITLE_PREFIX make -C "$backend_dir" OS="$os" MSYSTEM="$msys" NULL_REDIR= BUILD_TIME=simulated -n "$target" 2>/dev/null \
			| grep -F "$marker" \
			| sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g' \
			|| true)
	fi
	if [ "$got" = "$want" ]; then
		printf 'ok    %-16s %-12s %s\n' "$label" "$target" "$got"
		if [ "$label" = windows-native ] && [ "$target" = build-kandev ]; then
			windows_mkdir_recipe="$got"
		fi
	else
		printf 'FAIL  %-16s %-12s\n        want: %s\n        got:  %s\n' \
			"$label" "$target" "$want" "$got"
		status=1
	fi
}

# Unix — no .exe, POSIX env-prefix + exec.
expect unix '' '' run         './bin/kandev __backend'
expect unix '' '' dev         'KANDEV_DEBUG_DEV_MODE=true exec ./bin/kandev __backend'
expect unix '' '' start-debug "KANDEV_DEBUG_PPROF_ENABLED=true KANDEV_LOG_LEVEL=debug KANDEV_WEB_TITLE_PREFIX='Debug' exec ./bin/kandev __backend"
expect unix '' '' start-debug "KANDEV_DEBUG_PPROF_ENABLED=true KANDEV_LOG_LEVEL=debug KANDEV_WEB_TITLE_PREFIX='Preview' exec ./bin/kandev __backend" __backend Preview
expect unix '' '' start-debug "KANDEV_DEBUG_PPROF_ENABLED=true KANDEV_LOG_LEVEL=debug KANDEV_WEB_TITLE_PREFIX='QA Debug' exec ./bin/kandev __backend" __backend "QA Debug"

# Native Windows (cmd/PowerShell) — .exe, `set VAR=VAL&`, backslash path, no exec.
expect windows-native Windows_NT '' run         '"bin\kandev.exe" __backend'
expect windows-native Windows_NT '' dev         'set KANDEV_DEBUG_DEV_MODE=true& "bin\kandev.exe" __backend'
expect windows-native Windows_NT '' start-debug 'set KANDEV_DEBUG_PPROF_ENABLED=true& set KANDEV_LOG_LEVEL=debug& set "KANDEV_WEB_TITLE_PREFIX=Debug"& "bin\kandev.exe" __backend'
expect windows-native Windows_NT '' start-debug 'set KANDEV_DEBUG_PPROF_ENABLED=true& set KANDEV_LOG_LEVEL=debug& set "KANDEV_WEB_TITLE_PREFIX=Preview"& "bin\kandev.exe" __backend' __backend Preview
expect windows-native Windows_NT '' start-debug 'set KANDEV_DEBUG_PPROF_ENABLED=true& set KANDEV_LOG_LEVEL=debug& set "KANDEV_WEB_TITLE_PREFIX=QA Debug"& "bin\kandev.exe" __backend' __backend "QA Debug"

# Git Bash/MSYS — .exe suffix but POSIX syntax (recipes run through sh).
expect git-bash Windows_NT MINGW64 run         './bin/kandev.exe __backend'
expect git-bash Windows_NT MINGW64 dev         'KANDEV_DEBUG_DEV_MODE=true exec ./bin/kandev.exe __backend'
expect git-bash Windows_NT MINGW64 start-debug "KANDEV_DEBUG_PPROF_ENABLED=true KANDEV_LOG_LEVEL=debug KANDEV_WEB_TITLE_PREFIX='Debug' exec ./bin/kandev.exe __backend"
expect git-bash Windows_NT MINGW64 start-debug "KANDEV_DEBUG_PPROF_ENABLED=true KANDEV_LOG_LEVEL=debug KANDEV_WEB_TITLE_PREFIX='Preview' exec ./bin/kandev.exe __backend" __backend Preview
expect git-bash Windows_NT MINGW64 start-debug "KANDEV_DEBUG_PPROF_ENABLED=true KANDEV_LOG_LEVEL=debug KANDEV_WEB_TITLE_PREFIX='QA Debug' exec ./bin/kandev.exe __backend" __backend "QA Debug"

# deadcode — the analyzer is invoked through the same shell-specific env-prefix
# mechanism, but its command has no __backend marker, so match its module path.
# Git Bash additionally carries the CGO_LOCALE prefix (LC_ALL=C): deadcode compiles
# the -tags fts5 cgo packages, and this mingw gcc mis-decodes its own non-ASCII
# install path under a UTF-8 locale (see docs/public/windows-support.md). LC_ALL=C
# (not LANG=C) is used so it overrides an inherited LC_ALL/LC_CTYPE. Unix and
# native cmd stay locale-free.
expect unix '' '' deadcode \
	'GOTOOLCHAIN=go1.26.0 go run golang.org/x/tools/cmd/deadcode@v0.48.0 -tags fts5 ./...' \
	'golang.org/x/tools/cmd/deadcode'
expect windows-native Windows_NT '' deadcode \
	'set GOTOOLCHAIN=go1.26.0& go run golang.org/x/tools/cmd/deadcode@v0.48.0 -tags fts5 ./...' \
	'golang.org/x/tools/cmd/deadcode'
expect git-bash Windows_NT MINGW64 deadcode \
	'LC_ALL=C GOTOOLCHAIN=go1.26.0 go run golang.org/x/tools/cmd/deadcode@v0.48.0 -tags fts5 ./...' \
	'golang.org/x/tools/cmd/deadcode'

# test — a second CGO_LOCALE consumer, so the prefix is not proven for deadcode
# alone. The `test` recipe is deterministic (no version/timestamp ldflags), so
# assert it in full across all three shells: Git Bash carries LC_ALL=C, Unix and
# native cmd do not.
expect git-bash Windows_NT MINGW64 test \
	'LC_ALL=C CGO_ENABLED=1 go test -trimpath -tags fts5 ./...' \
	'go test -trimpath -tags fts5'
expect unix '' '' test \
	'CGO_ENABLED=1 go test -trimpath -tags fts5 ./...' \
	'go test -trimpath -tags fts5'
expect windows-native Windows_NT '' test \
	'set CGO_ENABLED=1& go test -trimpath -tags fts5 ./...' \
	'go test -trimpath -tags fts5'

# mkdir — the Windows branch must check for the directory before calling cmd's
# mkdir, so rebuilding over an existing bin/ stays quiet while other errors stay
# visible. Unix and Git Bash use idempotent `mkdir -p`, which is silent by design.
expect unix '' '' build-kandev 'mkdir -p "bin"' mkdir
expect windows-native Windows_NT '' build-kandev 'cmd /c if not exist "bin" mkdir "bin"' mkdir
expect git-bash Windows_NT MINGW64 build-kandev 'mkdir -p "bin"' mkdir

# When cmd.exe is available, execute the captured native-Windows recipe against
# a temporary directory. This checks that an existing directory stays quiet.
check_native_mkdir_behavior() {
	local recipe=$1 cmd_bin inner probe_name probe_dir stderr_file first_status
	if ! cmd_bin=$(command -v cmd.exe 2>/dev/null); then
		printf 'skip  %-16s cmd.exe is not available\n' "native-mkdir"
		return
	fi

	probe_name=".make-shell-check-$$"
	probe_dir="$backend_dir/$probe_name"
	stderr_file=$(mktemp)
	inner=${recipe#cmd /c }
	inner=${inner//bin/$probe_name}

	rm -rf "$probe_dir"
	first_status=0
	(cd "$backend_dir" && "$cmd_bin" /c "$inner") 2>"$stderr_file" || first_status=$?
	if [ "$first_status" -ne 0 ] || [ ! -d "$probe_dir" ] || [ -s "$stderr_file" ]; then
		printf 'FAIL  %-16s first mkdir did not create a quiet directory\n' "native-mkdir"
		status=1
		rm -rf "$probe_dir"
		rm -f "$stderr_file"
		return
	fi

	: >"$stderr_file"
	(cd "$backend_dir" && "$cmd_bin" /c "$inner") 2>"$stderr_file" || true
	if [ -s "$stderr_file" ]; then
		printf 'FAIL  %-16s existing directory wrote to stderr\n' "native-mkdir"
		status=1
	else
		printf 'ok    %-16s existing directory stayed quiet\n' "native-mkdir"
	fi

	rm -rf "$probe_dir"
	rm -f "$stderr_file"
}

if [ -n "$windows_mkdir_recipe" ]; then
	check_native_mkdir_behavior "$windows_mkdir_recipe"
fi

# Root web build environment.
#
# The root Makefile compiles the frontend for `make start`, `start-verbose`,
# and `start-debug`. An inherited NODE_ENV must not switch Vite/React into its
# development runtime, while `make dev`/`dev-web` must keep the caller's
# environment. Execute the real recipes with a pnpm recorder so the assertion
# is made at the command boundary, not against Makefile text.
root_dir="$(cd "$backend_dir/../.." && pwd)"
root_probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/kandev-make-shells.XXXXXX")
root_record_file="$root_probe_dir/invocations"
trap 'rm -rf "$root_probe_dir"' EXIT

cat >"$root_probe_dir/pnpm" <<'RECORDER'
#!/usr/bin/env bash
set -euo pipefail
field() {
	local name=$1
	if [ -z "${!name+x}" ]; then
		printf '<unset>'
	elif [ -z "${!name}" ]; then
		printf '<empty>'
	else
		printf '%s' "${!name}"
	fi
}
printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
	"$PWD" \
	"$*" \
	"$(field NODE_ENV)" \
	"$(field VITE_KANDEV_API_PORT)" \
	"$(field VITE_KANDEV_DEBUG)" \
	"$(field PORT)" >>"${KANDEV_MAKE_SHELLS_RECORD:?}"
RECORDER
chmod +x "$root_probe_dir/pnpm"

root_expect() {
	local label=$1 want=$2 got=${3-}
	if [ "$got" = "$want" ]; then
		printf 'ok    %-20s %s\n' "$label" "$got"
	else
		printf 'FAIL  %-20s\n        want: %s\n        got:  %s\n' "$label" "$want" "$got"
		status=1
	fi
}

# root_run <input node env|unset> <target> records one pnpm invocation.
root_run() {
	local input=$1 target=$2
	: >"$root_record_file"
	if [ "$input" = unset ]; then
		env -u NODE_ENV PATH="$root_probe_dir:$PATH" \
			KANDEV_MAKE_SHELLS_RECORD="$root_record_file" \
			make -C "$root_dir" "$target" >/dev/null 2>&1
	else
		NODE_ENV="$input" PATH="$root_probe_dir:$PATH" \
			KANDEV_MAKE_SHELLS_RECORD="$root_record_file" \
			make -C "$root_dir" "$target" >/dev/null 2>&1
	fi
}

# root_run_inherited <target> records one pnpm invocation using the caller's
# exported environment unchanged.
root_run_inherited() {
	local target=$1
	: >"$root_record_file"
	PATH="$root_probe_dir:$PATH" \
		KANDEV_MAKE_SHELLS_RECORD="$root_record_file" \
		make -C "$root_dir" "$target" >/dev/null 2>&1
}

# root_field <record line> <tab-separated field number>
root_field() {
	awk -F '\t' -v line="$1" -v field="$2" 'NR == line { print $field }' "$root_record_file"
}

# @covers AC-PLATFORM-SQLITE-SNAPSHOT-001.4, AC-PLATFORM-STARTUP-LIFECYCLE-001.7
# Version defaults are queried through real Make expansion in disposable Git
# histories. The query file only prints each Makefile's public version variable.
version_targets="$root_probe_dir/version-targets.mk"
cat >"$version_targets" <<'MAKE'
.PHONY: print-runtime-version print-backend-version
print-runtime-version:
	@printf '%s\n' '$(RUNTIME_VERSION)'
print-backend-version:
	@printf '%s\n' '$(VERSION)'
MAKE

make_runtime_version() {
	local fixture=$1
	local git_ceiling=${GIT_CEILING_DIRECTORIES-}
	local -a git_env=()
	shift
	if [ -n "$git_ceiling" ]; then
		git_env=("GIT_CEILING_DIRECTORIES=$git_ceiling")
	fi
	env -u RUNTIME_VERSION -u GIT_CEILING_DIRECTORIES "${git_env[@]}" make -s -C "$fixture" \
		-f "$root_dir/Makefile" -f "$version_targets" \
		NULL_REDIR= BUILD_TIME=fixture "$@" print-runtime-version 2>/dev/null
}

make_backend_version() {
	local fixture=$1
	local git_ceiling=${GIT_CEILING_DIRECTORIES-}
	local -a git_env=()
	shift
	if [ -n "$git_ceiling" ]; then
		git_env=("GIT_CEILING_DIRECTORIES=$git_ceiling")
	fi
	env -u VERSION -u GIT_CEILING_DIRECTORIES "${git_env[@]}" make -s -C "$fixture" \
		-f "$root_dir/apps/backend/Makefile" -f "$version_targets" \
		NULL_REDIR= BUILD_TIME=fixture "$@" print-backend-version 2>/dev/null
}

init_version_fixture() {
	local fixture=$1
	mkdir -p "$fixture"
	git -C "$fixture" init -q
	git -C "$fixture" config user.name 'Kandev Make Check'
	git -C "$fixture" config user.email 'make-check@example.invalid'
	git -C "$fixture" config core.abbrev 7
	git -C "$fixture" config commit.gpgSign false
	git -C "$fixture" config tag.gpgSign false
	mkdir -p "$fixture/hooks"
	git -C "$fixture" config core.hooksPath "$fixture/hooks"
}

version_history="$root_probe_dir/version-history"
init_version_fixture "$version_history"
printf 'runtime release\n' >"$version_history/runtime.txt"
git -C "$version_history" add runtime.txt
git -C "$version_history" commit -qm 'runtime release'
git -C "$version_history" tag v1.2.3
printf 'next runtime commit\n' >>"$version_history/runtime.txt"
git -C "$version_history" commit -qam 'runtime commit after release'
runtime_commit=$(git -C "$version_history" rev-parse --short HEAD)
runtime_tag_version="v1.2.3-1-g$runtime_commit"

root_runtime_only=$(make_runtime_version "$version_history")
backend_runtime_only=$(make_backend_version "$version_history")
root_expect root-runtime-tag-only "$runtime_tag_version" "$root_runtime_only"
root_expect backend-runtime-tag-only "$runtime_tag_version" "$backend_runtime_only"

# A newer SDK tag at HEAD must not replace the runtime release description.
git -C "$version_history" tag pluginsdk/v0.1.0
root_with_sdk_tag=$(make_runtime_version "$version_history")
backend_with_sdk_tag=$(make_backend_version "$version_history")
root_expect root-ignores-sdk-tag "$root_runtime_only" "$root_with_sdk_tag"
root_expect backend-ignores-sdk-tag "$backend_runtime_only" "$backend_with_sdk_tag"

# A v-prefixed namespace also matches v[0-9]* unless slash tags are excluded.
namespaced_history="$root_probe_dir/namespaced-history"
init_version_fixture "$namespaced_history"
printf 'runtime release\n' >"$namespaced_history/runtime.txt"
git -C "$namespaced_history" add runtime.txt
git -C "$namespaced_history" commit -qm 'runtime release'
git -C "$namespaced_history" tag v1.2.3
printf 'next runtime commit\n' >>"$namespaced_history/runtime.txt"
git -C "$namespaced_history" commit -qam 'runtime commit after release'
namespaced_runtime_commit=$(git -C "$namespaced_history" rev-parse --short HEAD)
namespaced_runtime_version="v1.2.3-1-g$namespaced_runtime_commit"
git -C "$namespaced_history" tag v1/pluginsdk/v0.1.0
root_v_prefixed_namespace=$(make_runtime_version "$namespaced_history")
backend_v_prefixed_namespace=$(make_backend_version "$namespaced_history")
root_expect root-excludes-v-namespace "$namespaced_runtime_version" "$root_v_prefixed_namespace"
root_expect backend-excludes-v-namespace "$namespaced_runtime_version" "$backend_v_prefixed_namespace"

# With SDK-only history, --always must produce the fixture's commit hash.
sdk_only_history="$root_probe_dir/sdk-only-history"
init_version_fixture "$sdk_only_history"
printf 'SDK release\n' >"$sdk_only_history/sdk.txt"
git -C "$sdk_only_history" add sdk.txt
git -C "$sdk_only_history" commit -qm 'SDK release'
git -C "$sdk_only_history" tag pluginsdk/v0.1.0
sdk_only_commit=$(git -C "$sdk_only_history" rev-parse --short HEAD)
root_sdk_only=$(make_runtime_version "$sdk_only_history")
backend_sdk_only=$(make_backend_version "$sdk_only_history")
root_expect root-sdk-only-hash-fallback "$sdk_only_commit" "$root_sdk_only"
root_expect backend-sdk-only-hash-fallback "$sdk_only_commit" "$backend_sdk_only"

# Dirty state and explicit Make overrides retain their existing precedence.
printf 'dirty worktree\n' >>"$version_history/runtime.txt"
root_dirty=$(make_runtime_version "$version_history")
backend_dirty=$(make_backend_version "$version_history")
root_expect root-dirty-suffix "$root_runtime_only-dirty" "$root_dirty"
root_expect backend-dirty-suffix "$backend_runtime_only-dirty" "$backend_dirty"
root_expect root-explicit-override explicit-runtime \
	"$(make_runtime_version "$version_history" RUNTIME_VERSION=explicit-runtime)"
root_expect backend-explicit-override explicit-backend \
	"$(make_backend_version "$version_history" VERSION=explicit-backend)"

# This nested path belongs to a known Git worktree until the ceiling is applied.
outside_git="$version_history/outside-git"
mkdir -p "$outside_git"
root_expect root-parent-git-control "$root_dirty" "$(make_runtime_version "$outside_git")"
root_expect backend-parent-git-control "$backend_dirty" "$(make_backend_version "$outside_git")"
root_expect root-outside-git-fallback dev \
	"$(GIT_CEILING_DIRECTORIES="$version_history" make_runtime_version "$outside_git")"
root_expect backend-outside-git-fallback dev \
	"$(GIT_CEILING_DIRECTORIES="$version_history" make_backend_version "$outside_git")"

# The four Node environments must all compile production React at the pnpm
# boundary. `build-web-e2e` keeps its package-level pseudo-locale selection.
for node_env in development test production unset; do
	if root_run "$node_env" build-web; then
		root_expect "web-$node_env-env" production "$(root_field 1 3)"
	else
		root_expect "web-$node_env-exit" 0 "$?"
	fi
done

for target in build-web build-web-quiet build-web-e2e; do
	case $target in
		build-web-e2e) want_args='--filter @kandev/web build:e2e' ;;
		*) want_args='--filter @kandev/web build' ;;
	esac
	if root_run development "$target"; then
		root_expect "$target-env" production "$(root_field 1 3)"
		root_expect "$target-cwd" "$root_dir/apps" "$(root_field 1 1)"
		root_expect "$target-args" "$want_args" "$(root_field 1 2)"
		root_expect "$target-api-port" '<empty>' "$(root_field 1 4)"
		root_expect "$target-debug" '<empty>' "$(root_field 1 5)"
	else
		root_expect "$target-exit" 0 "$?"
	fi
done

# Dependency installation must stay in the caller's environment: pinning
# NODE_ENV=production before `pnpm install` would drop dev dependencies.
if root_run development install-web; then
	root_expect install-web-env development "$(root_field 1 3)"
	root_expect install-web-args 'install --silent' "$(root_field 1 2)"
	root_expect install-playwright-env development "$(root_field 2 3)"
	root_expect install-playwright-args '--filter @kandev/web exec playwright install chromium' "$(root_field 2 2)"
else
	root_expect install-web-exit 0 "$?"
fi

# Development entry points keep development React for both inherited values.
for node_env in development '<unset>'; do
	input=$node_env
	[ "$node_env" = '<unset>' ] && input=unset
	if root_run "$input" dev-web; then
		root_expect "dev-web-$node_env-env" "$node_env" "$(root_field 1 3)"
		root_expect "dev-web-$node_env-cwd" "$root_dir/apps" "$(root_field 1 1)"
		root_expect "dev-web-$node_env-args" '--filter @kandev/web dev' "$(root_field 1 2)"
		root_expect "dev-web-$node_env-port" 37429 "$(root_field 1 6)"
	else
		root_expect "dev-web-$node_env-exit" 0 "$?"
	fi
done

# A production build must not mutate the invoking shell's NODE_ENV; a later
# development command in the same shell must still receive development.
if (
	export NODE_ENV=development
	root_run development build-web
	root_run_inherited dev-web
	[ "$(root_field 1 3)" = development ]
); then
	root_expect subsequent-dev-environment development development
else
	root_expect subsequent-dev-environment development changed
fi

# Native Windows frontend recipe generation. This proves cmd.exe syntax, not
# execution; a Windows host is still required for the latter.
root_dry_run() {
	local target=$1
	shift
	env -u NODE_ENV make -C "$root_dir" "$@" NODE=node MAKE=echo NULL_REDIR= \
		-n "$target" 2>/dev/null
}

normalize_recipe() {
	sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/[[:space:]]\{1,\}/ /g'
}

if root_dry_run start-windows OS=Windows_NT MSYSTEM= >"$root_probe_dir/windows-recipe" 2>/dev/null; then
	root_expect windows-frontend-build \
		'cd apps && set "VITE_KANDEV_API_PORT=" && set "VITE_KANDEV_DEBUG=" && set "NODE_ENV=production" && pnpm --filter @kandev/web build' \
		"$(grep -F 'NODE_ENV=production' "$root_probe_dir/windows-recipe" | normalize_recipe)"
else
	root_expect windows-frontend-build 0 "$?"
fi

for alias_pair in start-windows-verbose:start-windows:VERBOSE \
	start-windows-debug:start-windows:DEBUG \
	start-verbose:start:VERBOSE \
	start-debug:start:DEBUG; do
	target=${alias_pair%%:*}
	rest=${alias_pair#*:}
	want="echo ${rest%%:*} ${rest#*:}=1"
	root_expect "$target-alias" "$want" \
		"$(root_dry_run "$target" | grep -F "$want" | normalize_recipe)"
done

# Static guard: no literal /dev/null inside $(shell ...).
#
# Unlike a recipe, which only ever runs on a platform its target supports,
# $(shell ...) expands at parse time on EVERY invocation, through whatever shell
# make picked. Under native cmd there is no /dev/null: cmd resolves the
# redirection first, fails on the missing \dev directory, and hands the value to
# the fallback — so the probe silently returns its default on Windows while
# every POSIX host looks fine. Use $(NULL_REDIR), which carries the right token
# per shell. This runs on the Linux CI, where the Windows branch is otherwise
# never exercised.
# Fail closed: grep exits 1 for "no matches" but >1 for a real scan error, and
# swallowing the difference would let an unreadable or moved Makefile report ok.
grep_status=0
# `#` starts a comment anywhere in a Makefile line, so the match must not span
# one: [^#]* keeps a prose mention like `FOO = bar # $(shell x 2>/dev/null)`
# from failing CI, and cannot reach past a whole-line comment either. It matches
# empty so a bare `$(shell ...)` in column 0 still counts.
devnull_hits=$(grep -nE '^[[:space:]]*[^#]*\$\(shell[^#]*/dev/null' \
	"$backend_dir/../../Makefile" "$backend_dir/Makefile") || grep_status=$?
if [ "$grep_status" -gt 1 ]; then
	printf 'FAIL  %-16s unable to scan Makefiles (grep exit %s)\n' "static" "$grep_status"
	status=1
elif [ -n "$devnull_hits" ]; then
	printf 'FAIL  %-16s literal /dev/null inside $(shell ...) — use $(NULL_REDIR)\n' "static"
	printf '        %s\n' "$devnull_hits"
	status=1
else
	printf 'ok    %-16s %s\n' "static" 'no literal /dev/null inside $(shell ...)'
fi

# Static guard: native cgo host builds carry the $(CGO_LOCALE) prefix.
#
# kandev (-tags fts5) and agentctl both import cgo (go list -deps reports CgoFiles),
# so their native `go build` invokes gcc and fails on a non-ASCII toolchain path
# under Git Bash unless prefixed with $(CGO_LOCALE) — exactly the miss that first
# shipped build-agentctl without it. Cross builds set CGO_ENABLED=0 / GOOS= and do
# not invoke gcc, so they are excluded. Extend the cmd list here if another host
# binary starts importing cgo.
cgo_status=0
cgo_unprefixed=$(grep -nE '\$\(GO\) build' "$backend_dir/Makefile" \
	| grep -E '\./cmd/(kandev|agentctl)$' \
	| grep -vE 'CGO_LOCALE|GOOS=|\$\(GO_(LINUX|DARWIN)') || cgo_status=$?
if [ "$cgo_status" -gt 1 ]; then
	printf 'FAIL  %-16s unable to scan Makefile (grep exit %s)\n' "static-cgo" "$cgo_status"
	status=1
elif [ -n "$cgo_unprefixed" ]; then
	printf 'FAIL  %-16s native cgo build without $(CGO_LOCALE):\n' "static-cgo"
	printf '        %s\n' "$cgo_unprefixed"
	status=1
else
	printf 'ok    %-16s %s\n' "static-cgo" 'native cgo host builds carry $(CGO_LOCALE)'
fi

if [ "$status" -eq 0 ]; then
	echo "All Makefile shell and version checks passed (3-shell recipes, release-tag selection and fallbacks, root web environments, and static guards)."
fi
exit "$status"
